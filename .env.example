# Gemini: free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opik Cloud: free account at https://www.comet.com/signup?from=llm
# Fill in both, or leave them blank and run `uv run opik configure` once instead.
OPIK_API_KEY=
OPIK_WORKSPACE=

# Self-hosted Opik instead? Set this and leave the two above blank.
# OPIK_URL_OVERRIDE=http://localhost:5173/api

# Optional
# ADK_MODEL=gemini-3.8-flash
# JUDGE_MODEL=gemini/gemini-3.8-flash
# OPIK_PROJECT_NAME=google-adk-support-agent
